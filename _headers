# Fingerprinted assets can be reused; site/manifest updates still revalidate.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/avon
  Cache-Control: no-cache
/avon-extended
  Cache-Control: no-cache
/chautauqua
  Cache-Control: no-cache
/data/:site/surfaces-*.bin.gz
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
/data/:site/surfaces.json
  Cache-Control: no-cache
/data/:site/stream/*.bin.gz
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
/data/:site/stream/manifest.json
  Cache-Control: no-cache
