// Chautauqua's independent domain-root deployment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chautauqua-miniature",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "chautauqua.town", "custom_domain": true }],
  "build": {
    "command": "sh scripts/cloudflare-build.sh chautauqua"
  },
  "assets": {
    "directory": "./dist/chautauqua",
    "html_handling": "auto-trailing-slash"
  },
  // `wrangler deploy --env staging`: the chautauqua-miniature-staging Worker at staging.chautauqua.town,
  // built by Workers Builds from the `staging` branch. Routes are not inherited.
  "env": {
    "staging": {
      "routes": [{ "pattern": "staging.chautauqua.town", "custom_domain": true }]
    }
  }
}
