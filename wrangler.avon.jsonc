// avon.town: the Avon miniature at the domain root; the original village-centre scene stays at /avon.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avon-town",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "avon.town", "custom_domain": true }],
  "build": {
    "command": "python3 -m tinytown stage --target town"
  },
  "assets": {
    "directory": "./dist/town",
    "html_handling": "auto-trailing-slash"
  }
}
