// avon.town: the Avon miniature at the domain root; the original village-centre scene stays at /avon.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avon-town",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "avon.town", "custom_domain": true }],
  "build": {
    "command": "sh scripts/cloudflare-build.sh avon"
  },
  "assets": {
    "directory": "./dist/avon",
    "html_handling": "auto-trailing-slash"
  },
  // `wrangler deploy --env staging`: the avon-town-staging Worker at staging.avon.town,
  // built by Workers Builds from the `staging` branch. Routes are not inherited.
  "env": {
    "staging": {
      "routes": [{ "pattern": "staging.avon.town", "custom_domain": true }]
    }
  }
}
